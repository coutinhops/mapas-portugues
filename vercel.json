{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/imagens/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/indicacao",
      "destination": "/index.html"
    }
  ]
}